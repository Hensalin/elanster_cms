# Backend settings (put the real values in Vercel → Settings → Environment Variables, never in Git)
PGHOST=your-project-host.pooler.supabase.com
PGPORT=5432
PGUSER=postgres.your-project-ref
PGDATABASE=postgres
PGPASSWORD=
SESSION_SECRET=
# Optional: where the admin screens live, so opening the backend address sends people there
FRONTEND_URL=

# Git publishing: a fine-grained GitHub token with "Contents: Read and write" on the website repos only.
GITHUB_TOKEN=
